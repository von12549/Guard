<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>v4-web-companion</AssemblyName>
    <RootNamespace>V4.Guards.WebCompanion</RootNamespace>
    <Version>1.1.6</Version>
    <AssemblyVersion>1.1.6.0</AssemblyVersion>
    <PathMap>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', '..'))=/_/</PathMap>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="wwwroot\**\*" />
    <EmbeddedResource Include="wwwroot\index.html" LogicalName="V4.Guards.WebCompanion.UI.index.html" />
    <EmbeddedResource Include="wwwroot\app.js" LogicalName="V4.Guards.WebCompanion.UI.app.js" />
    <EmbeddedResource Include="wwwroot\styles.css" LogicalName="V4.Guards.WebCompanion.UI.styles.css" />
  </ItemGroup>
</Project>
