{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/web-spike/stage-run-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "command", "hostExitCode", "hostResult"],
  "properties": {
    "formatVersion": { "const": 1 },
    "command": { "const": "stage.run" },
    "hostExitCode": { "type": "integer", "minimum": 0, "maximum": 255 },
    "hostResult": { "type": "object" }
  }
}
