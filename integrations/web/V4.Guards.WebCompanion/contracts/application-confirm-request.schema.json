{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/web/application-confirm-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["operationId", "projectId", "previewHash"],
  "properties": {
    "operationId": { "enum": ["setup", "protection", "authorities", "lifecycle"] },
    "projectId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "previewHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
