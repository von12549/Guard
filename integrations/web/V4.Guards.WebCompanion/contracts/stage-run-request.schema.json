{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/web/stage-run-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "profile", "withDependencies"],
  "properties": {
    "stage": { "enum": ["bootstrap", "analysis", "pre", "post"] },
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "withDependencies": { "type": "boolean" }
  }
}
