{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/contracts/v1-certification.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "id", "version", "status", "sourceCommit", "packageHash", "archiveSha256", "contractsManifestSha256", "compatibilityBaselineSha256", "platformReports", "acceptance", "releaseAuthorized", "activeIfxCutover", "ifxProfileIncluded", "architectureRuntimeDependencies"],
  "properties": {
    "formatVersion": { "const": 1 }, "id": { "const": "v4-guards-v1-candidate" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }, "status": { "const": "candidate" },
    "sourceCommit": { "$ref": "#/definitions/commit" }, "packageHash": { "$ref": "#/definitions/sha256" }, "archiveSha256": { "$ref": "#/definitions/sha256" }, "contractsManifestSha256": { "$ref": "#/definitions/sha256" }, "compatibilityBaselineSha256": { "$ref": "#/definitions/sha256" },
    "platformReports": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["platform", "coverage", "path", "sha256", "testCount"], "properties": {
      "platform": { "enum": ["linux", "windows"] }, "coverage": { "enum": ["complete", "full"] }, "path": { "$ref": "#/definitions/path" }, "sha256": { "$ref": "#/definitions/sha256" }, "testCount": { "type": "integer", "minimum": 1 }
    } } },
    "acceptance": { "const": ["P8.1-platforms", "P8.2-lifecycle", "P8.3-supply-chain", "P8.4-compatibility-recovery", "P8.5-v4-native-architecture"] },
    "releaseAuthorized": { "const": false }, "activeIfxCutover": { "const": false }, "ifxProfileIncluded": { "const": false },
    "architectureRuntimeDependencies": { "type": "array", "uniqueItems": true, "items": { "enum": ["pwsh", "dotnet", "roslyn", "archunitnet"] } }
  },
  "definitions": {
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
