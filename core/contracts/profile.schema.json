{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/contracts/profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "version", "projectIdentity", "moduleSelections", "stageConfiguration", "rules", "baselineRefs"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "projectIdentity": {
      "type": "object", "additionalProperties": false, "required": ["id"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }, "relativeRoots": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$" } } }
    },
    "workspaceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativeRoots", "extensions", "excludedDirectoryNames", "maximumFiles", "maximumFileBytes"],
      "properties": {
        "relativeRoots": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$" }
        },
        "extensions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^\\.[A-Za-z0-9]+$" }
        },
        "excludedDirectoryNames": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
        },
        "maximumFiles": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "maximumFileBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 }
      }
    },
    "moduleSelections": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "versionRange", "config"],
        "properties": { "id": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "versionRange": { "type": "string", "minLength": 1 }, "config": { "type": "object" } }
      }
    },
    "stageConfiguration": {
      "type": "object", "additionalProperties": false, "required": ["bootstrap", "analysis", "pre", "post"],
      "properties": {
        "bootstrap": { "$ref": "#/definitions/stage" }, "analysis": { "$ref": "#/definitions/stage" },
        "pre": { "$ref": "#/definitions/stage" }, "post": { "$ref": "#/definitions/stage" }
      }
    },
    "rules": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$" } },
    "baselineRefs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$" } }
  },
  "definitions": {
    "stage": { "type": "object", "additionalProperties": false, "required": ["enabled", "modules"], "properties": { "enabled": { "type": "boolean" }, "modules": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } } } }
  }
}
