{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/contracts/platform-certification.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "status", "platform", "coverage", "sourceCommit", "packageHash", "osDescription", "architecture", "toolchain", "tests", "secretEnvironmentNames"],
  "properties": {
    "formatVersion": { "const": 1 }, "status": { "const": "pass" },
    "platform": { "enum": ["linux", "windows"] }, "coverage": { "enum": ["complete", "full"] },
    "sourceCommit": { "$ref": "#/definitions/commit" }, "packageHash": { "$ref": "#/definitions/sha256" },
    "osDescription": { "type": "string", "minLength": 1 }, "architecture": { "enum": ["x64", "arm64"] },
    "toolchain": { "type": "object", "additionalProperties": false, "required": ["pwsh", "dotnet", "git"], "properties": {
      "pwsh": { "type": "string", "minLength": 1 }, "dotnet": { "type": "string", "minLength": 1 }, "git": { "type": "string", "minLength": 1 }
    } },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "resultSha256"], "properties": {
      "path": { "$ref": "#/definitions/path" }, "sha256": { "$ref": "#/definitions/sha256" }, "resultSha256": { "$ref": "#/definitions/sha256" }
    } } },
    "secretEnvironmentNames": { "type": "array", "maxItems": 0 }
  },
  "definitions": {
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
  }
}
