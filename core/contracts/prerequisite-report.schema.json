{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/contracts/prerequisite-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "status", "exitCategory", "profile", "selectedModules", "requirements"],
  "properties": {
    "formatVersion": { "const": 1 },
    "status": { "enum": ["pass", "error"] },
    "exitCategory": { "enum": ["success", "prerequisite-missing"] },
    "profile": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "selectedModules": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9-]+$" } },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime", "versionRange", "sources", "status"],
        "properties": {
          "runtime": { "enum": ["dotnet", "pwsh", "node", "git"] },
          "versionRange": { "type": "string", "minLength": 1 },
          "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "status": { "enum": ["pass", "missing", "incompatible"] },
          "detectedVersion": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}$" },
          "executablePath": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
