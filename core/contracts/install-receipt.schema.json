{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/contracts/install-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "status", "version", "installRoot", "archiveSha256", "manifestSha256", "files"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "status": { "enum": ["installed", "uninstalled"] },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "installRoot": { "type": "string", "minLength": 1 },
    "archiveSha256": { "$ref": "#/definitions/sha256" },
    "manifestSha256": { "$ref": "#/definitions/sha256" },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "sha256": { "$ref": "#/definitions/sha256" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "definitions": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
