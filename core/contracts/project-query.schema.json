{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/contracts/project-query.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "status", "query", "authority", "project", "roots"],
  "properties": {
    "formatVersion": { "const": 1 },
    "status": { "const": "pass" },
    "query": { "const": "project" },
    "authority": { "const": "v4-host" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "targetRoot", "targetIdentityHash", "bound", "profileId", "stateDocumentStatus"],
      "properties": {
        "projectId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
        "targetRoot": { "type": "string", "minLength": 1 },
        "targetIdentityHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "bound": { "type": "boolean" },
        "profileId": { "type": ["string", "null"], "pattern": "^[a-z][a-z0-9_-]*$" },
        "stateDocumentStatus": { "enum": ["missing", "valid"] }
      }
    },
    "roots": { "$ref": "#/definitions/roots" }
  },
  "definitions": {
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageRoot", "targetRoot", "stateRoot", "evidenceRoot"],
      "properties": {
        "packageRoot": { "type": "string", "minLength": 1 },
        "targetRoot": { "type": "string", "minLength": 1 },
        "stateRoot": { "type": "string", "minLength": 1 },
        "evidenceRoot": { "type": "string", "minLength": 1 }
      }
    }
  }
}
