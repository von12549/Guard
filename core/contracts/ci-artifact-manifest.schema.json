{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/contracts/ci-artifact-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "baseSha", "headSha", "contractSha256", "packageHash", "buildEvidence", "linuxTests", "files"],
  "properties": {
    "formatVersion": { "const": 1 },
    "baseSha": { "$ref": "#/definitions/commit" },
    "headSha": { "$ref": "#/definitions/commit" },
    "contractSha256": { "$ref": "#/definitions/sha256" },
    "packageHash": { "$ref": "#/definitions/sha256" },
    "buildEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configuration", "targetFramework", "sourceSha256", "hostPath", "hostSha256", "secretEnvironmentNames"],
      "properties": {
        "configuration": { "const": "Release" },
        "targetFramework": { "const": "net10.0" },
        "sourceSha256": { "$ref": "#/definitions/sha256" },
        "hostPath": { "const": "host/v4-guards.dll" },
        "hostSha256": { "$ref": "#/definitions/sha256" },
        "secretEnvironmentNames": { "type": "array", "maxItems": 0 }
      }
    },
    "linuxTests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/relativePath" } },
    "files": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": { "$ref": "#/definitions/relativePath" },
          "sha256": { "$ref": "#/definitions/sha256" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "definitions": {
    "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "relativePath": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$" }
  }
}
