{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/contracts/rule-execution-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "moduleId", "matrixSha256", "rules"],
  "properties": {
    "formatVersion": { "const": 1 },
    "moduleId": { "const": "architecture-conformance" },
    "matrixSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rules": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["ruleId", "claimId", "stage", "detectors", "evidenceKinds", "severity", "baseline", "minimumMatches"], "properties": {
      "ruleId": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$" },
      "claimId": { "type": "string" },
      "stage": { "enum": ["pre", "post"] },
      "detectors": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
      "evidenceKinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
      "severity": { "enum": ["advisory", "blocking"] },
      "baseline": { "type": ["string", "null"] },
      "minimumMatches": { "type": "integer", "minimum": 1 }
    } } }
  }
}
