{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/contracts/run-catalog-query.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "status", "query", "authority", "projectId", "runs"],
  "properties": {
    "formatVersion": { "const": 1 },
    "status": { "const": "pass" },
    "query": { "const": "runs" },
    "authority": { "const": "v4-host" },
    "projectId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runId", "stage", "status", "exitCategory", "profileId", "profileVersion", "resultSha256", "executedStages", "findingCount", "coverageCount"],
        "properties": {
          "runId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
          "stage": { "enum": ["bootstrap", "analysis", "pre", "post"] },
          "status": { "enum": ["pass", "advisory", "fail", "error"] },
          "exitCategory": { "enum": ["success", "invalid-input", "unsafe-path", "integrity-failure", "capability-denied", "adapter-failure", "prerequisite-missing", "findings-blocking", "state-conflict", "reset-refused", "internal-error"] },
          "profileId": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "profileVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "resultSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "executedStages": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["bootstrap", "analysis", "pre", "post"] } },
          "findingCount": { "type": "integer", "minimum": 0 },
          "coverageCount": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
