{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/contracts/composition-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "kind", "id", "status", "installRoot", "productVersion", "compositionManifestSha256", "packageHash", "baseArchiveSha256", "baseReceiptSha256", "bundleManifestSha256", "reviewRecordSha256", "files"],
  "properties": {
    "formatVersion": { "const": 1 },
    "kind": { "const": "local-extension-composition" },
    "id": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "status": { "enum": ["installed", "synthetic-test-only"] },
    "installRoot": { "type": "string", "minLength": 1 },
    "productVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "compositionManifestSha256": { "$ref": "#/definitions/sha256" },
    "packageHash": { "$ref": "#/definitions/sha256" },
    "baseArchiveSha256": { "$ref": "#/definitions/sha256" },
    "baseReceiptSha256": { "$ref": "#/definitions/sha256" },
    "bundleManifestSha256": { "$ref": "#/definitions/sha256" },
    "reviewRecordSha256": { "$ref": "#/definitions/sha256" },
    "files": {
      "type": "array", "minItems": 3, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "size"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "sha256": { "$ref": "#/definitions/sha256" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "definitions": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
