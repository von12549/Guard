{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/contracts/runtime-requirements.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "requirements"],
  "properties": {
    "formatVersion": { "const": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["runtime", "versionRange"],
        "properties": {
          "runtime": { "enum": ["dotnet", "pwsh", "node", "git"] },
          "versionRange": { "type": "string", "pattern": "^(?:>=|>)[0-9]+(?:\\.[0-9]+){0,3}(?: (?:<=|<)[0-9]+(?:\\.[0-9]+){0,3})?$" }
        }
      }
    }
  }
}
