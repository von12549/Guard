{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/contracts/distribution-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "version", "rootDirectory", "source", "files"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "const": "v4-guards" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "rootDirectory": { "type": "string", "pattern": "^v4-guards-[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "packageHash", "contractsManifestSha256", "hostSha256"],
      "properties": {
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "packageHash": { "$ref": "#/definitions/sha256" },
        "contractsManifestSha256": { "$ref": "#/definitions/sha256" },
        "hostSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "sha256", "size"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?:package|host)/(?!.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "kind": { "enum": ["package", "host"] },
          "sha256": { "$ref": "#/definitions/sha256" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "definitions": { "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
