{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "stage", "moduleId", "status", "exitCategory", "findings", "adapterSha256", "roots"],
  "properties": {
    "formatVersion": { "const": 1 },
    "stage": { "const": "analysis" },
    "moduleId": { "const": "synthetic-probe" },
    "status": { "enum": ["pass", "fail", "error"] },
    "exitCategory": { "enum": ["success", "invalid-input", "unsafe-path", "integrity-failure", "capability-denied", "adapter-failure"] },
    "findings": { "type": "array", "items": { "type": "string" } },
    "adapterSha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageRoot", "targetRoot", "stateRoot", "evidenceRoot"],
      "properties": {
        "packageRoot": { "type": "string", "minLength": 1 },
        "targetRoot": { "type": "string", "minLength": 1 },
        "stateRoot": { "type": "string", "minLength": 1 },
        "evidenceRoot": { "type": "string", "minLength": 1 }
      }
    }
  }
}
