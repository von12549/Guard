{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://v4.guards.local/governance/target-trust-authorization.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "planId", "policyId", "entries", "acceptedBy"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[0-9]{8}-[a-z0-9-]+$" },
    "planId": { "type": "string", "pattern": "^[0-9]{8}-[a-z0-9-]+$" },
    "policyId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "entries": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "baseSha256", "headSha256"],
        "properties": {
          "path": { "$ref": "#/definitions/path" },
          "baseSha256": { "oneOf": [{ "$ref": "#/definitions/hash" }, { "type": "null" }] },
          "headSha256": { "oneOf": [{ "$ref": "#/definitions/hash" }, { "type": "null" }] }
        }
      }
    },
    "acceptedBy": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "authority", "candidateHostVerdictAllowed"],
      "properties": {
        "kind": { "const": "human-review" },
        "authority": { "type": "string", "minLength": 1 },
        "candidateHostVerdictAllowed": { "const": false }
      }
    }
  },
  "definitions": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }
  }
}
