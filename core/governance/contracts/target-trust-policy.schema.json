{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://v4.guards.local/governance/target-trust-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "id", "authorizationDirectory", "protectedPaths"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "authorizationDirectory": { "$ref": "#/definitions/path" },
    "protectedPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+(?:/\\*\\*)?$" }
    }
  },
  "definitions": {
    "path": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" }
  }
}
