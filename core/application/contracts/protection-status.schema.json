{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/application/contracts/protection-status.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["protected", "localRunnable", "ciConfigured", "ciEnforced", "components"],
  "properties": {
    "protected": { "type": "boolean" },
    "localRunnable": { "type": "boolean" },
    "ciConfigured": { "type": "boolean" },
    "ciEnforced": { "type": "boolean" },
    "components": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence", "required"],
        "properties": {
          "id": { "enum": ["initialized-context", "accepted-non-empty-profile", "verified-immutable-composition", "satisfied-prerequisites", "required-stage-coverage", "ci-authority-pin", "aggregate-verdict-enforcement"] },
          "status": { "enum": ["pass", "fail", "unverified"] },
          "evidence": { "type": "string", "minLength": 1 },
          "required": { "const": true }
        }
      }
    }
  }
}
