{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ifx.local/v4/application/contracts/host-safety-proof.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "status", "authority", "capturedAtUtc", "projectId", "packageAuthoritySha256", "targetSnapshotSha256", "checks", "profiles", "operations", "boundaries"],
  "properties": {
    "formatVersion": { "const": 1 },
    "status": { "const": "pass" },
    "authority": { "const": "v4-host-safety-proof" },
    "capturedAtUtc": { "type": "string", "format": "date-time" },
    "projectId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "packageAuthoritySha256": { "$ref": "#/definitions/sha256" },
    "targetSnapshotSha256": { "$ref": "#/definitions/sha256" },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["userEnvironment", "machineEnvironment", "processPath"],
      "properties": {
        "userEnvironment": { "$ref": "#/definitions/hashComparison" },
        "machineEnvironment": { "$ref": "#/definitions/hashComparison" },
        "processPath": { "$ref": "#/definitions/hashComparison" }
      }
    },
    "profiles": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scope", "beforeExists", "afterExists", "beforeSha256", "afterSha256", "equal"],
        "properties": {
          "scope": { "enum": ["all-users-all-hosts", "all-users-current-host", "current-user-all-hosts", "current-user-current-host"] },
          "beforeExists": { "type": "boolean" },
          "afterExists": { "type": "boolean" },
          "beforeSha256": { "anyOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] },
          "afterSha256": { "anyOf": [{ "$ref": "#/definitions/sha256" }, { "type": "null" }] },
          "equal": { "const": true }
        }
      }
    },
    "operations": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": { "enum": ["application-contract", "project-query", "profile-query", "target-discovery"] }
    },
    "boundaries": {
      "type": "object", "additionalProperties": false,
      "required": ["hashesOnly", "containsPathValues", "containsEnvironmentValues", "targetWrite", "ciActivation", "remoteMutation", "humanAcceptance"],
      "properties": {
        "hashesOnly": { "const": true },
        "containsPathValues": { "const": false },
        "containsEnvironmentValues": { "const": false },
        "targetWrite": { "const": false },
        "ciActivation": { "const": false },
        "remoteMutation": { "const": false },
        "humanAcceptance": { "const": false }
      }
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "hashComparison": {
      "type": "object", "additionalProperties": false,
      "required": ["beforeSha256", "afterSha256", "equal"],
      "properties": {
        "beforeSha256": { "$ref": "#/definitions/sha256" },
        "afterSha256": { "$ref": "#/definitions/sha256" },
        "equal": { "const": true }
      }
    }
  }
}
