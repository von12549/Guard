{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://guards.local/v4/modules/build-evidence-provider/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "status", "findings", "coverage"],
  "properties": {
    "formatVersion": { "const": 1 },
    "status": { "enum": ["pass", "error"] },
    "exitCategory": { "enum": ["success", "invalid-input", "unsafe-path", "integrity-failure", "prerequisite-missing", "adapter-failure"] },
    "message": { "type": "string" },
    "findings": { "type": "array", "maxItems": 0 },
    "coverage": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["claimId", "matched", "minimum"], "properties": { "claimId": { "const": "BUILD.EVIDENCE" }, "matched": { "type": "integer", "minimum": 0 }, "minimum": { "type": "integer", "minimum": 1 } } } }
  }
}
