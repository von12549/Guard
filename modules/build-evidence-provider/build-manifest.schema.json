{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://guards.local/v4/modules/build-evidence-provider/build-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "runId", "projectId", "createdUtc", "configuration", "targetFramework", "targetSnapshotSha256", "assemblies"],
  "properties": {
    "formatVersion": { "const": 1 },
    "runId": { "type": "string", "pattern": "^[a-f0-9]{32}$" },
    "projectId": { "type": "string", "minLength": 1 },
    "createdUtc": { "type": "string", "minLength": 20 },
    "configuration": { "enum": ["Debug", "Release"] },
    "targetFramework": { "type": "string", "pattern": "^net[0-9]+\\.[0-9]+$" },
    "targetSnapshotSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "assemblies": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["assemblyName", "sourceProject", "configuration", "targetFramework", "statePath", "sha256"],
        "properties": {
          "assemblyName": { "type": "string", "minLength": 1 },
          "sourceProject": { "type": "string", "minLength": 1 },
          "configuration": { "enum": ["Debug", "Release"] },
          "targetFramework": { "type": "string", "pattern": "^net[0-9]+\\.[0-9]+$" },
          "statePath": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
