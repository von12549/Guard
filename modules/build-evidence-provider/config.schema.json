{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://guards.local/v4/modules/build-evidence-provider/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["configuration", "targetFramework", "manifestPath", "projects"],
  "properties": {
    "configuration": { "enum": ["Debug", "Release"] },
    "targetFramework": { "type": "string", "pattern": "^net[0-9]+\\.[0-9]+$" },
    "manifestPath": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).*\\{projectId\\}.*$" },
    "projects": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["projectPath", "assemblyName"],
        "properties": {
          "projectPath": { "type": "string", "pattern": "^(?![A-Za-z]:|/|.*(?:^|/)\\.\\.(?:/|$)).+\\.csproj$" },
          "assemblyName": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" }
        }
      }
    }
  }
}
